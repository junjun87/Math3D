# ===== 阿里云文字识别 OCR（推荐，按次计费） =====
# 相机拍照后通过阿里云 OCR 识别图片中题目文字
# 在 https://ram.console.aliyun.com/manage/ak 创建 AccessKey
ALIBABA_CLOUD_ACCESS_KEY_ID=LTAI5txxxxxxxxxxxx
ALIBABA_CLOUD_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== LLM 配置（题面解析 + OCR fallback） =====
# 支持任意 OpenAI 兼容 API：DeepSeek、GPT-4o、通义千问 等
# 用于题面结构化解析；未配置则降级为关键词匹配
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
